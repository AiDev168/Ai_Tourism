# Dedicated TLS origin. Arvan must connect to this listener using HTTPS;
# never forward authenticated staging traffic over the shared HTTP :63201.
# Requires a valid certificate for the exact hostname before installation.
server {
    listen 63202 ssl default_server;
    server_name __RAHGARD_PUBLIC_HOST__;
    server_tokens off;
    client_max_body_size 128k;
    ssl_certificate /etc/letsencrypt/live/__RAHGARD_PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__RAHGARD_PUBLIC_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    location ~* ^/(admin|api/v1/admin|api/v1/auth/local-owner)(/|$) { return 404; }
    location ~* ^/api/v1/auth/(otp|debug|local-owner)(/|$) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # TLS is protected all the way to this Nginx listener.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_read_timeout 80s;
        proxy_send_timeout 30s;
    }
}
