# Install only as a new, dedicated vhost after Arvan DNS/HTTPS has been
# configured for this exact hostname. Never replace an existing site file.
server {
    listen 63201;
    server_name __RAHGARD_PUBLIC_HOST__;
    server_tokens off;
    client_max_body_size 128k;

    location ~* ^/(admin|api/v1/admin|api/v1/auth/local-owner)(/|$) { return 404; }
    location ~* ^/api/v1/auth/(otp|debug|local-owner)(/|$) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Arvan terminates HTTPS before reaching this origin listener. This
        # fixed header is trusted only for the explicit Arvan HTTPS hostname.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_read_timeout 80s;
        proxy_send_timeout 30s;
    }
}
