# Non-secret runtime routing only. Copy to .env on the isolated host.
# Owner-selected public hostname; browser traffic must use trusted HTTPS.
RAHGARD_PUBLIC_HOST=rahgard.hinaa.ir
RAHGARD_COMPOSE_PROJECT=rahgard-staging
RAHGARD_PG_VOLUME=rahgard_staging_pgdata
RAHGARD_WEB_BIND_PORT=18080
RAHGARD_CHAT_ENABLED=true
RAHGARD_CHAT_MODEL=Qwen3-VL-30B-A3B-Instruct
RAHGARD_RELEASE_SHA=unbuilt
RAHGARD_SECRET_DIR=/opt/rahgard-staging/secrets
RAHGARD_STATE_DIR=/opt/rahgard-staging/state
