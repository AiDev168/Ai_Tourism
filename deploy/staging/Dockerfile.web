FROM node:22.14-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/staging/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY deploy/staging/nginx-security-headers.conf /etc/nginx/rahgard-security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html
# The release archive is created with umask 077. Ensure the public PWA files
# are readable by the unprivileged Nginx worker regardless of source modes.
# Compare content hashes across chmod so this packaging fix cannot silently
# rewrite or omit the built shell, service worker, manifest, or hashed assets.
RUN set -eu; \
    find /usr/share/nginx/html -type f -exec sha256sum {} \; | sort > /tmp/rahgard-static-before.sha256; \
    find /usr/share/nginx/html -type d -exec chmod 0755 {} +; \
    find /usr/share/nginx/html -type f -exec chmod 0644 {} +; \
    find /usr/share/nginx/html -type f -exec sha256sum {} \; | sort > /tmp/rahgard-static-after.sha256; \
    cmp -s /tmp/rahgard-static-before.sha256 /tmp/rahgard-static-after.sha256; \
    rm -f /tmp/rahgard-static-before.sha256 /tmp/rahgard-static-after.sha256; \
    test -r /usr/share/nginx/html/manifest.webmanifest; \
    test -r /usr/share/nginx/html/sw.js
EXPOSE 8080
