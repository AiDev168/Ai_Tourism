APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_HOST=127.0.0.1
DATABASE_PORT=55433
DATABASE_NAME=ai_tourism_dev
DATABASE_USER=ai_tourism_app
DATABASE_PASSWORD=replace-with-local-app-role-password
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# Authentication is disabled by default.
AUTH_ENABLED=false
AUTH_SMS_ADAPTER=disabled

# Sandbox placeholder only. Never put a real API key in this file.
SMS_IR_SANDBOX_API_KEY=replace-with-sms-ir-sandbox-api-key
